import React from 'react';

// Generate dummy text for testing scrolling
const generateDummyText = (frameName: string, count: number = 500) => {
  const lines = [];
  for (let i = 1; i <= count; i++) {
    lines.push(`${frameName} - Line ${i}`);
  }
  return lines.join('\n');
};

